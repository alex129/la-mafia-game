---                               
  import '../styles/global.css'  
---   

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
		<link rel="icon" type="image/svg+xml" href="/game-over.png" />
		<meta name="generator" content={Astro.generator} />
		<title>La Mafia Game</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
	</head>
	<body class="bg-[#9ba657] min-h-screen">
		<div class="min-h-screen bg-[#9ba657] relative">
			<div class="absolute inset-0" style="background-image: radial-gradient(#8b945f 2px, transparent 2px); background-size: 32px 32px;"></div>
			<div class="relative">
				<slot />
			</div>
		</div>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		font-family: 'Press Start 2P', cursive;
		image-rendering: pixelated;
	}
</style>
