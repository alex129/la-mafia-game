### Repository Implementation

```typescript
// src/infrastructure/repositories/DrizzleUserRepository.ts (Non-monorepo)
// OR packages/backend/src/infrastructure/repositories/DrizzleUserRepository.ts (Monorepo)
import { db } from "../db";
import { users } from "../db/schema";
import { UserRepository } from "../../domain/user/contracts/UserRepository"; // Non-monorepo
// import { UserRepository } from '@shared/domain/user/contracts/UserRepository'; // Monorepo
import { User } from "../../domain/user/User"; // Non-monorepo
// import { User } from '@shared/domain/user/User'; // Monorepo
import { DatabaseError } from "../../domain/shared/errors/DatabaseError"; // Non-monorepo
// import { DatabaseError } from '@shared/domain/shared/errors/DatabaseError'; // Monorepo
import { eq, inArray } from "drizzle-orm";

export class DrizzleUserRepository implements UserRepository {
  async save(user: User): Promise<void> {
    try {
      const data = {
        id: user.id,
        email: user.email,
        name: user.name,
        lastname: user.lastname,
        role: user.role,
        created_at: user.created_at,
      };

      await db
        .insert(users)
        .values(data)
        .onConflictDoUpdate({
          target: [users.id],
          set: {
            name: user.name,
            lastname: user.lastname,
            role: user.role,
          },
        });
    } catch (error) {
      throw new DatabaseError(
        error instanceof Error ? error.message : "Unknown error"
      );
    }
  }

  async findById(id: string): Promise<User | null> {
    try {
      const userDb = await db.query.users.findFirst({
        where: eq(users.id, id),
      });

      if (!userDb) {
        return null;
      }

      return new User({
        id: userDb.id,
        email: userDb.email,
        name: userDb.name,
        lastname: userDb.lastname,
        role: userDb.role,
        created_at: userDb.created_at,
      });
    } catch (error) {
      throw new DatabaseError(
        error instanceof Error ? error.message : "Error finding user"
      );
    }
  }

  async findByEmail(email: string): Promise<User | null> {
    try {
      const userDb = await db.query.users.findFirst({
        where: eq(users.email, email),
      });

      if (!userDb) {
        return null;
      }

      return User.fromPrimitives(userDb);
    } catch (error) {
      throw new DatabaseError(
        error instanceof Error ? error.message : "Error finding user by email"
      );
    }
  }

  async findByIds(ids: string[]): Promise<User[]> {
    if (ids.length === 0) {
      return [];
    }

    try {
      const usersDb = await db.query.users.findMany({
        where: inArray(users.id, ids),
      });

      return usersDb.map((userDb) => User.fromPrimitives(userDb));
    } catch (error) {
      throw new DatabaseError(
        error instanceof Error ? error.message : "Error finding users by IDs"
      );
    }
  }

  async delete(id: string): Promise<void> {
    try {
      await db.delete(users).where(eq(users.id, id));
    } catch (error) {
      throw new DatabaseError(
        error instanceof Error ? error.message : "Error deleting user"
      );
    }
  }
}
```

### API Handler Implementation

```typescript
// src/infrastructure/api/backoffice/user/post.ts (Non-monorepo)
// OR packages/backend/src/infrastructure/api/backoffice/user/post.ts (Monorepo)
import { APIGatewayProxyHandler } from "aws-lambda";
import { CreateUser } from "../../../application/user/CreateUser";
import { DIContainer } from "../../di/DIContainer";
import { ContainerNames } from "../../di/ContainerNames";
import { ResponseHandler } from "../../http/handlers/ResponseHandler";
import { CreateUserRequestSchema } from "../../../../domain/schemas/user/CreateUserRequestSchema"; // Non-monorepo
// import { CreateUserRequestSchema } from '@shared/domain/schemas/user/CreateUserRequestSchema'; // Monorepo

const container = DIContainer.getInstance();

// Get dependencies via DI
const userRepository = container.getByName<UserRepository>(
  ContainerNames.USER_REPOSITORY
);
const eventBusService = container.getByName<EventBusService>(
  ContainerNames.EVENT_BUS_SERVICE
);

// Instantiate use case
const createUser = new CreateUser(userRepository, eventBusService);

export const handler: APIGatewayProxyHandler = async (event) => {
  try {
    const body = JSON.parse(event.body || "{}");
    const userData = CreateUserRequestSchema.parse(body);

    const user = await createUser.execute(userData);

    return ResponseHandler.success(
      user.toPrimitives(),
      "User created successfully"
    );
  } catch (error) {
    return ResponseHandler.error(error);
  }
};
```

### Dependency Injection Container

```typescript
// src/infrastructure/di/DIContainer.ts (Non-monorepo)
// OR packages/backend/src/infrastructure/di/DIContainer.ts (Monorepo)
export class DIContainer {
  private static instance: DIContainer;
  private readonly dependencies = new Map<string, any>();
  private readonly metadata = new Map<string, DependencyMetadata>();
  private dependenciesRegistered = false;

  static getInstance(): DIContainer {
    if (!DIContainer.instance) {
      DIContainer.instance = new DIContainer();
    }
    return DIContainer.instance;
  }

  register<T>(
    classConstructor: Constructor<T>,
    dependencies: Constructor[] | string[] = []
  ): void {
    const name = classConstructor.name;
    this.metadata.set(name, {
      constructor: classConstructor,
      dependencies,
    });
  }

  registerByName<T>(
    name: string,
    classConstructor: Constructor<T>,
    dependencies: Constructor[] | string[] = []
  ): void {
    this.metadata.set(name, {
      constructor: classConstructor,
      dependencies,
    });
  }

  get<T>(classConstructor: Constructor<T>): T {
    this.ensureDependenciesRegistered();
    return this.resolve(classConstructor.name);
  }

  getByName<T>(name: string): T {
    this.ensureDependenciesRegistered();
    return this.resolve(name);
  }

  private ensureDependenciesRegistered(): void {
    if (this.dependenciesRegistered) return;

    new InfrastructureContainer().register(this);
    new UseCaseContainer().register(this);

    this.dependenciesRegistered = true;
  }

  private resolve<T>(name: string): T {
    if (this.dependencies.has(name)) {
      return this.dependencies.get(name);
    }

    const metadata = this.metadata.get(name);
    if (!metadata) {
      throw new Error(`Dependency '${name}' not found`);
    }

    const resolvedDependencies = metadata.dependencies.map((dep) =>
      typeof dep === "string" ? this.resolve(dep) : this.resolve(dep.name)
    );

    const instance = new metadata.constructor(...resolvedDependencies);
    this.dependencies.set(name, instance); // Singleton cache

    return instance;
  }
}
```

```typescript
// src/infrastructure/di/containers/InfrastructureContainer.ts (Non-monorepo)
// OR packages/backend/src/infrastructure/di/containers/InfrastructureContainer.ts (Monorepo)
import { DependencyContainer } from "../DependencyContainer";
import { DIContainer } from "../DIContainer";
import { ContainerNames } from "../ContainerNames";

export class InfrastructureContainer extends DependencyContainer {
  register(container: DIContainer): void {
    // Services
    container.registerByName(ContainerNames.STORAGE_SERVICE, S3StorageService);
    container.registerByName(ContainerNames.EMAIL_SERVICE, EmailService);
    container.registerByName(
      ContainerNames.EVENT_BUS_SERVICE,
      EventBridgeService
    );

    // Repositories
    container.registerByName(
      ContainerNames.USER_REPOSITORY,
      DrizzleUserRepository
    );
    container.registerByName(
      ContainerNames.CACHE_USER_REPOSITORY,
      CacheUserRepository,
      [ContainerNames.USER_REPOSITORY]
    );

    // Cache repositories with decorator pattern
    container.registerByName(
      ContainerNames.CACHE_USER_REPOSITORY,
      CacheUserRepository,
      [ContainerNames.USER_REPOSITORY]
    );
  }
}
```

