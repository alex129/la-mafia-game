### Error Structure

```typescript
// src/domain/user/errors/UserNotFound.ts (Non-monorepo)
// OR packages/shared/src/domain/user/errors/UserNotFound.ts (Monorepo)
import { AppError } from "../../shared/AppError";

export class UserNotFound extends AppError {
  constructor(userId?: string) {
    super({
      message: userId ? `User with ID ${userId} not found` : "User not found",
      httpCode: 404,
      name: "UserNotFound",
