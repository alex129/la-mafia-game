## 🧪 Testing Structure (`tests/`)

### Object Mother Pattern

```typescript
// tests/domain/user/UserMother.ts (Non-monorepo)
// OR packages/shared/tests/domain/user/UserMother.ts (Monorepo)
import { User } from "../../../src/domain/user/User"; // Non-monorepo
// import { User } from '../../../src/domain/user/User'; // Monorepo shared package
import { AuthRole } from "../../../src/domain/auth/AuthRole"; // Non-monorepo
// import { AuthRole } from '../../../src/domain/auth/AuthRole'; // Monorepo shared package
import { randomUUID } from "crypto";

export class UserMother {
  static basic(): User {
    return new User({
      id: randomUUID(),
      email: "test@example.com",
      name: "Test",
      lastname: "User",
      role: AuthRole.USER,
      created_at: new Date(),
    });
  }

  static admin(): User {
    return new User({
      id: randomUUID(),
      email: "admin@example.com",
      name: "Admin",
      lastname: "User",
      role: AuthRole.ADMIN,
      created_at: new Date(),
    });
  }

  static withParameters({
    id = randomUUID(),
    email = "custom@example.com",
    name = "Custom",
    lastname = "User",
    role = AuthRole.USER,
    created_at = new Date(),
  }: {
    id?: string;
    email?: string;
    name?: string;
    lastname?: string;
    role?: AuthRole;
    created_at?: Date;
  } = {}): User {
    return new User({
      id,
      email,
      name,
      lastname,
      role,
      created_at,
    });
  }
}
```

