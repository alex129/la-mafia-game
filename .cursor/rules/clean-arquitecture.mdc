  readonly findByIdsMock = vi.fn();
  readonly deleteMock = vi.fn();

  // Assert methods for testing
  assertSaveCalledWith(user: User) {
    expect(this.saveMock).toHaveBeenCalledWith(user);
  }

  assertFindByIdCalledWith(id: string) {
    expect(this.findByIdMock).toHaveBeenCalledWith(id);
  }

  assertFindByEmailCalledWith(email: string) {
    expect(this.findByEmailMock).toHaveBeenCalledWith(email);
  }

  assertDeleteCalledWith(id: string) {
    expect(this.deleteMock).toHaveBeenCalledWith(id);
  }

  // Implementation methods
  async save(user: User): Promise<void> {
    this.saveMock(user);
  }

  async findById(id: string): Promise<User | null> {
    return this.findByIdMock(id);
  }

  async findByEmail(email: string): Promise<User | null> {
    return this.findByEmailMock(email);
  }

  async findByIds(ids: string[]): Promise<User[]> {
    return this.findByIdsMock(ids);
  }

  async delete(id: string): Promise<void> {
    this.deleteMock(id);
  }
}
```

### Use Case Testing Pattern

```typescript
// tests/application/user/CreateUser.test.ts (Non-monorepo)
// OR packages/backend/tests/application/user/CreateUser.test.ts (Monorepo)
import { describe, it, expect, beforeEach } from "vitest";
import { CreateUser } from "../../../src/application/user/CreateUser"; // Non-monorepo
// import { CreateUser } from '../../../src/application/user/CreateUser'; // Monorepo backend package
import { UserRepositoryMock } from "../../domain/user/UserRepositoryMock"; // From tests/
// import { UserRepositoryMock } from '@shared/tests/domain/user/UserRepositoryMock'; // Monorepo
import { EventBusServiceMock } from "../../infrastructure/services/EventBusServiceMock";
import { UserMother } from "../../domain/user/UserMother"; // From tests/
// import { UserMother } from '@shared/tests/domain/user/UserMother'; // Monorepo
import { UserCreated } from "../../../src/domain/user/events/UserCreated"; // Non-monorepo
// import { UserCreated } from '@shared/domain/user/events/UserCreated'; // Monorepo

describe("CreateUser", () => {
  let createUser: CreateUser;
  let userRepository: UserRepositoryMock;
  let eventBusService: EventBusServiceMock;

  beforeEach(() => {
    userRepository = new UserRepositoryMock();
    eventBusService = new EventBusServiceMock();
    createUser = new CreateUser(userRepository, eventBusService);
  });

