### Shared Base Classes

```typescript
// src/domain/shared/Serializable.ts (Non-monorepo)
// OR packages/shared/src/domain/shared/Serializable.ts (Monorepo)
export abstract class Serializable {
  abstract toPrimitives(): Record<string, any>;
}

// src/domain/shared/AppError.ts (Non-monorepo)
// OR packages/shared/src/domain/shared/AppError.ts (Monorepo)
export abstract class AppError extends Error {
  public readonly httpCode: number;
  public readonly name: string;

  constructor({
    message,
    httpCode,
    name,
  }: {
    message: string;
    httpCode: number;
    name: string;
  }) {
    super(message);
    this.httpCode = httpCode;
    this.name = name;
  }
}

// src/domain/shared/Uuid.ts (Non-monorepo)
// OR packages/shared/src/domain/shared/Uuid.ts (Monorepo)
export default class Uuid {
  private readonly value: string;

  constructor(value?: string) {
    this.value = value || crypto.randomUUID();
  }

  getValue(): string {
    return this.value;
  }
}
```

