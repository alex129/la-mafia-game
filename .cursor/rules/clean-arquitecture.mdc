## 📦 Application Layer (`src/application/` or `backend/src/application/`)

### Application Layer Structure

Contains use cases and business logic orchestration:

```
src/application/                         # Non-monorepo
# OR packages/backend/src/application/    # Monorepo
├── {entity}/
│   ├── Create{Entity}.ts           # Creation use cases
│   ├── Find{Entity}ById.ts         # Query use cases
│   ├── List{Entity}s.ts            # List use cases
│   ├── Update{Entity}.ts           # Update use cases
│   ├── Delete{Entity}.ts           # Delete use cases
│   ├── events/                     # Domain event subscribers
│   │   └── Send{Action}On{Event}.ts
│   └── notifications/              # Notification handlers
│       └── Send{Entity}Notification.ts
└── shared/                         # Shared application services
    ├── EventBusService.ts
    └── interfaces/
```

### Use Case Implementation

```typescript
// src/application/user/FindUserById.ts (Non-monorepo)
// OR packages/backend/src/application/user/FindUserById.ts (Monorepo)
import { UserRepository } from "../../domain/user/contracts/UserRepository"; // Non-monorepo
// import { UserRepository } from '@shared/domain/user/contracts/UserRepository'; // Monorepo
import { User } from "../../domain/user/User"; // Non-monorepo
// import { User } from '@shared/domain/user/User'; // Monorepo
import { UserNotFound } from "../../domain/user/errors/UserNotFound"; // Non-monorepo
// import { UserNotFound } from '@shared/domain/user/errors/UserNotFound'; // Monorepo

export class FindUserById {
  constructor(private userRepository: UserRepository) {}

  async execute(userId: string): Promise<User> {
    const user = await this.userRepository.findById(userId);

    if (!user) {
      throw new UserNotFound(userId);
    }

    return user;
  }
}
```

```typescript
// src/application/user/CreateUser.ts (Non-monorepo)
// OR packages/backend/src/application/user/CreateUser.ts (Monorepo)
import { UserRepository } from "../../domain/user/contracts/UserRepository"; // Non-monorepo
// import { UserRepository } from '@shared/domain/user/contracts/UserRepository'; // Monorepo
import { User } from "../../domain/user/User"; // Non-monorepo
// import { User } from '@shared/domain/user/User'; // Monorepo
import { CreateUserContract } from "../../domain/user/contracts/UserContract"; // Non-monorepo
// import { CreateUserContract } from '@shared/domain/user/contracts/UserContract'; // Monorepo
import { EventBusService } from "../shared/EventBusService";
import { UserCreated } from "../../domain/user/events/UserCreated"; // Non-monorepo
// import { UserCreated } from '@shared/domain/user/events/UserCreated'; // Monorepo

export class CreateUser {
  constructor(
    private userRepository: UserRepository,
    private eventBusService: EventBusService
  ) {}

  async execute(userData: CreateUserContract): Promise<User> {
    const user = User.create(userData);

    await this.userRepository.save(user);

    // Publish domain event
    await this.eventBusService.publishEvent(
      new UserCreated({ user: user.toPrimitives() })
    );

    return user;
  }
}
```

