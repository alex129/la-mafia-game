## 🔄 Domain Events Architecture

### Domain Event Base Class

```typescript
// src/domain/shared/events/DomainEvent.ts (Non-monorepo)
// OR packages/shared/src/domain/shared/events/DomainEvent.ts (Monorepo)
export abstract class DomainEvent {
  public readonly eventId: string;
  public readonly occurredOn: Date;

  constructor(public readonly attributes: Record<string, any>) {
    this.eventId = crypto.randomUUID();
    this.occurredOn = new Date();
  }

  get eventName(): string {
    return this.constructor.name;
  }

  toPrimitives(): {
    eventId: string;
    eventName: string;
    occurredOn: string;
    attributes: Record<string, any>;
  } {
    return {
      eventId: this.eventId,
      eventName: this.eventName,
      occurredOn: this.occurredOn.toISOString(),
      attributes: this.attributes,
    };
  }
}
```

### Specific Domain Event

```typescript
// src/domain/user/events/UserCreated.ts (Non-monorepo)
// OR packages/shared/src/domain/user/events/UserCreated.ts (Monorepo)
import { DomainEvent } from "../../shared/events/DomainEvent";
import { UserContract } from "../contracts/UserContract";

export class UserCreated extends DomainEvent {
  constructor(attributes: { user: UserContract }) {
    super(attributes);
  }

  get user(): UserContract {
    return this.attributes.user;
  }
}
```

### Event Subscriber Pattern

```typescript
// src/domain/shared/events/DomainEventSubscriber.ts (Non-monorepo)
// OR packages/shared/src/domain/shared/events/DomainEventSubscriber.ts (Monorepo)
export interface DomainEventSubscriber<T extends DomainEvent> {
  subscribedTo(): DomainEventClass[];
  on(domainEvent: T): Promise<void>;
}

export type DomainEventClass = {
  new (...args: any[]): DomainEvent;
};
```

```typescript
// src/application/user/events/SendWelcomeEmailOnUserCreated.ts (Non-monorepo)
// OR packages/backend/src/application/user/events/SendWelcomeEmailOnUserCreated.ts (Monorepo)
import { DomainEventSubscriber } from "../../../domain/shared/events/DomainEventSubscriber"; // Non-monorepo
// import { DomainEventSubscriber } from '@shared/domain/shared/events/DomainEventSubscriber'; // Monorepo
import { UserCreated } from "../../../domain/user/events/UserCreated"; // Non-monorepo
// import { UserCreated } from '@shared/domain/user/events/UserCreated'; // Monorepo
import { EmailService } from "../../../infrastructure/services/EmailService";

export class SendWelcomeEmailOnUserCreated
  implements DomainEventSubscriber<UserCreated>
{
  constructor(private emailService: EmailService) {}

  subscribedTo(): DomainEventClass[] {
    return [UserCreated];
  }

  async on(domainEvent: UserCreated): Promise<void> {
    const user = domainEvent.user;

    await this.emailService.send({
      to: user.email,
      subject: "Welcome!",
      template: "welcome",
      data: { name: user.name },
    });
  }
}
```

