## 📦 Domain Layer (`src/domain/` or `shared/src/domain/`)

The domain layer contains all business logic, entities, contracts, and domain rules that form the core of your application.

### Domain Structure

Each domain object follows this consistent structure:

```
src/domain/                            # Non-monorepo
# OR packages/shared/src/domain/        # Monorepo
├── {entity}/
│   ├── {Entity}.ts                    # Main domain entity
│   ├── contracts/
│   │   ├── {Entity}Contract.ts        # Type contracts
│   │   ├── {Entity}Repository.ts      # Repository interface
│   │   └── Create{Entity}Contract.ts  # Operation-specific contracts
│   ├── errors/
│   │   ├── {Entity}NotFound.ts        # Domain-specific errors
│   │   └── Invalid{Entity}Error.ts    # Validation errors
│   ├── events/                        # Domain events (optional)
│   │   └── {Entity}Created.ts
│   └── {ValueObject}.ts               # Value objects and enums
└── shared/                            # Shared domain utilities
    ├── Serializable.ts
    ├── AppError.ts
    ├── Uuid.ts
    └── events/
        └── DomainEvent.ts
```

### Example: User Domain Object

```typescript
// src/domain/user/User.ts (Non-monorepo)
// OR packages/shared/src/domain/user/User.ts (Monorepo)
import { Serializable } from "../shared/Serializable";
import Uuid from "../shared/Uuid";
import { UserContract, CreateUserContract } from "./contracts/UserContract";

export class User extends Serializable {
  private readonly id_value: Uuid;
  public email: string;
  public name: string;
  public lastname: string;
  public role: AuthRole;
  public created_at: Date;

  constructor({
    id,
    email,
    name,
    lastname,
    role,
    created_at,
  }: {
    id?: string;
    email: string;
    name: string;
    lastname: string;
    role: AuthRole;
    created_at?: Date;
  }) {
    super();
    this.id_value = new Uuid(id);
    this.email = email;
    this.name = name;
    this.lastname = lastname;
    this.role = role;
    this.created_at = created_at ?? new Date();
  }

  // Factory method for creation
  static create({ email, name, lastname, role }: CreateUserContract): User {
    return new User({
      email,
      name,
      lastname,
      role: role || AuthRole.USER,
    });
  }

  // Factory method from primitives (database/API)
  static fromPrimitives(primitives: UserContract): User {
    return new User({
      id: primitives.id,
      email: primitives.email,
      name: primitives.name,
      lastname: primitives.lastname,
      role: primitives.role,
      created_at: primitives.created_at,
    });
  }

  // Getters
  get id(): string {
    return this.id_value.getValue();
  }

  get fullName(): string {
    return `${this.name} ${this.lastname}`;
  }

  // Business logic methods
  isAdmin(): boolean {
    return this.role === AuthRole.ADMIN;
  }

  hasRole(role: AuthRole): boolean {
    return this.role === role;
  }

  // Serialization
  toPrimitives(): UserContract {
    return {
      id: this.id,
      email: this.email,
      name: this.name,
      lastname: this.lastname,
      role: this.role,
      created_at: this.created_at,
    };
  }
}
```

### Contracts Structure

```typescript
// src/domain/user/contracts/UserContract.ts (Non-monorepo)
// OR packages/shared/src/domain/user/contracts/UserContract.ts (Monorepo)
import { AuthRole } from "../AuthRole";

export interface UserContract {
  id: string;
  email: string;
  name: string;
  lastname: string;
  role: AuthRole;
  created_at: Date;
}

export type CreateUserContract = Partial<UserContract> &
  Required<Pick<UserContract, "email" | "name" | "lastname">>;

export type UpdateUserContract = Partial<UserContract> &
  Required<Pick<UserContract, "name" | "lastname">>;
```

